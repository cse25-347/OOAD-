@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
hide empty members

class Customer {
  - id : String
  - firstName : String
  - surname : String
  - email : String
  - address : String
  - passwordHash : String
  - employer : String
  - employerAddress : String
  + isEmployed() : boolean
}

abstract class Account {
  - accountNumber : String
  - customerId : String
  - balance : BigDecimal
  - branch : String
  - dateOpened : LocalDate
  + deposit(amount : BigDecimal) : void
  + deposit(amount : BigDecimal, reference : String) : void
  + withdraw(amount : BigDecimal) : void {abstract}
  + getType() : AccountType {abstract}
}

interface InterestBearing {
  + monthlyRate() : BigDecimal
  + interestOn(balance : BigDecimal) : BigDecimal
}

class SavingsAccount {
  + monthlyRate() : BigDecimal
  + withdraw(amount : BigDecimal) : void
}
class InvestmentAccount {
  + OPENING_MINIMUM : BigDecimal = 500.00
  + monthlyRate() : BigDecimal
  + withdraw(amount : BigDecimal) : void
}
class ChequeAccount {
  + withdraw(amount : BigDecimal) : void
}

Customer "1" *-- "0..*" Account : owns
Account <|-- SavingsAccount
Account <|-- InvestmentAccount
Account <|-- ChequeAccount
InterestBearing <|.. SavingsAccount
InterestBearing <|.. InvestmentAccount

note right of SavingsAccount
  Monthly rate: 0.05%
  Withdrawals refused
end note
note right of InvestmentAccount
  Monthly rate: 5%
  BWP 500 minimum to open
end note
note bottom of ChequeAccount
  Employment details required
  at account creation
end note
@enduml
