@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #355474
skinparam packageStyle rectangle
actor Customer

rectangle "Banking System" {
  usecase "Register Profile" as Register
  usecase "Log In" as Login
  usecase "Open Account" as Open
  usecase "Open Investment\nAccount" as Invest
  usecase "Open Cheque\nAccount" as Cheque
  usecase "Deposit Funds" as Deposit
  usecase "Withdraw Funds" as Withdraw
  usecase "View Account and\nTransaction History" as History
  usecase "Pay Monthly Interest" as Interest
  usecase "Validate Ownership" as Authorise
}

Customer --> Register
Customer --> Login
Customer --> Open
Customer --> Deposit
Customer --> Withdraw
Customer --> History
Customer --> Interest

Invest ..> Open : <<extend>>
Cheque ..> Open : <<extend>>
Deposit ..> Authorise : <<include>>
Withdraw ..> Authorise : <<include>>
History ..> Authorise : <<include>>
Interest ..> Authorise : <<include>>
@enduml
